# =============================================================================
# DevOS Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- AI Provider Configuration ---
# At least one provider must be configured for AI features to work.
# You can also use Ollama for fully local AI (no API key needed).

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Ollama (local — no API key required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Default AI Provider ---
# Options: openai, anthropic, ollama
AI_PROVIDER=openai

# --- Server Configuration ---
DEVOS_PORT=3712
DEVOS_HOST=127.0.0.1

# --- Security ---
# Maximum command execution timeout in seconds
COMMAND_TIMEOUT=30
# Maximum file size to read (bytes)
MAX_FILE_SIZE=10485760

# --- Logging ---
# Options: debug, info, warn, error
LOG_LEVEL=info
